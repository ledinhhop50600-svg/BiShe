# 智能体服务配置模板
#
# 用法：复制本文件为 .env，按需填写。
#   ⚠️ 重要：**真实 Key 只能填在 .env 里，不要填在这个文件里** ——
#   本文件是提交到 Git 的模板，填在这里等于把 Key 公开。
#
#   copy .env.example .env

# 供应商：mock（不调用模型，用于联调与测试）/ deepseek（真实调用）
PROVIDER=mock

# 下面的配置在 PROVIDER=deepseek 时才需要
API_KEY=
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash

# 单次模型调用超时（秒）。应略小于主系统侧的 30 秒，保证 Agent 先返回错误
TIMEOUT_SECONDS=25

# ---- 规则检索（RAG）----
# 先从规则库召回最相关的若干条再交给模型；规则少时自动跳过检索直接用全量
RAG_ENABLED=true
RAG_TOP_K=6

# 向量化服务（硅基流动 bge-m3，免费）。需要单独注册，真实 Key 填在 .env 里
SILICONFLOW_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 响应回放（测试设施）：同一 requestId + 同一模型 返回缓存结果
REPLAY_ENABLED=true
REPLAY_DIR=.replay

# 与主系统之间的可选共享口令。留空表示不校验
AGENT_TOKEN=
