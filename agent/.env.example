# 智能体服务配置模板
#
# 用法：复制本文件为 .env，按需填写。.env 不会进版本库（见根目录 .gitignore）。
#
#   copy .env.example .env

# 供应商：mock（不调用模型，用于联调与测试）/ deepseek（真实调用）
PROVIDER=mock

# 下面的配置在 PROVIDER=deepseek 时才需要
API_KEY=
BASE_URL=https://api.deepseek.com
MODEL=deepseek-flash

# 单次模型调用超时（秒）。应略小于主系统侧的 30 秒，保证 Agent 先返回错误
TIMEOUT_SECONDS=25

# 响应回放（测试设施）：同一 requestId 返回缓存结果
REPLAY_ENABLED=true
REPLAY_DIR=.replay

# 与主系统之间的可选共享口令。留空表示不校验
AGENT_TOKEN=
